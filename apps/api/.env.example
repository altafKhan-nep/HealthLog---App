# --- Required ---
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthlog
JWT_SECRET=replace-with-a-long-random-string
# Public URL used when generating share links (use https:// in production)
PUBLIC_BASE_URL=http://192.168.254.5:4000

# --- CORS: comma-separated allowed web origins (native app needs none) ---
CORS_ORIGINS=http://localhost:4000,http://192.168.254.5:4000

# --- Cloudinary (file uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Groq (AI pipeline) ---
GROQ_API_KEY=your_groq_api_key
